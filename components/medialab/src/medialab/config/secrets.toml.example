# 复制本文件为 secrets.toml 并填入真实密钥。
# secrets.toml 已被 .gitignore 排除，严禁提交。
# 未配置的密钥不会阻塞下载功能，仅 ASR/OSS/refine 相关方法会返回明确错误。

[oss]
access_key_id = ""
access_key_secret = ""
region = "cn-beijing"
endpoint = "https://oss-cn-beijing.aliyuncs.com"
bucket = ""
prefix = "asr-temp/"

[asr]
api_key = ""
# 实测：公共 DashScope 端点即可（sk-ws- 前缀 key 有效），无需 workspace_id
base_url = "https://dashscope.aliyuncs.com/api/v1"

[refine]
# 可选：refine 专用密钥。provider = "dashscope" 时留空则复用 [asr].api_key；
# provider = "openai_compatible" 且 base_url 不是本机地址时必填；Ollama 不需要。
api_key = ""

[ocr]
# 可选：PaddleOCR API token（仅 [ocr] engine 使用 paddleocr_api 且 allow_cloud = true 时需要）。
token = ""
